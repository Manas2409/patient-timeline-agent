# Copy to .env and fill in. .env is gitignored.

# ---- Neo4j -----------------------------------------------------------------
# Aura:       neo4j+s://<id>.databases.neo4j.io
# Local:      bolt://localhost:7687
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- OpenAI (used by scripts/08_visit_agent.py) ----------------------------
OPENAI_API_KEY=

# ---- Anthropic (not currently used; kept if you switch script 8 back) ------
ANTHROPIC_API_KEY=
